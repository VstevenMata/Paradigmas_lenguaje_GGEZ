guild Jugador glhf
    solo lore nombre
    solo score puntos

    combo Jugador{lore n | score p} drops noloot glhf
        me.nombre set n
        me.puntos set p
    gg

    open combo subirNivel{score extra} drops noloot glhf
        me.puntos boost extra
    gg

    open combo esPro{} drops win glhf
        reward me.puntos atleast 90
    gg

    /w nombre es solo: desde afuera se lee con el getter, como en Java
    open combo getNombre{} drops lore glhf
        reward me.nombre
    gg
gg

lobby.launch{start THE GAME} glhf
    stash Jugador p1 set spawn Jugador{"mjsq" | 85}
    p1.subirNivel{10}

    stash squad[lore] turnos
    turnos.recruit{p1.getNombre{}}

    scan p1.esPro{} matches hit glhf
        chat.send{"Rango Pro"}
    gg
gg
