<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ParadigmasLenguajePropio.Controls">

    <!-- Mecanica compartida por TODOS los temas: un ControlTheme swapeado entero (como se probo
         primero para el bisel) no se re-aplica solo a los controles ya creados al cambiar de
         paleta en caliente - swapear Application.Styles reevalua bien los recursos usados como
         VALOR (DynamicResource en una propiedad), pero no fuerza a un control ya instanciado a
         re-resolver que ControlTheme le corresponde. Por eso el Template de Win95Bevel es UNICO y
         vive siempre aca: la forma (esquinas, grosor de cada anillo) sale de recursos
         DynamicResource (Thickness/CornerRadius, ver Themes/Paletas/*.axaml), nunca de un
         ControlTheme distinto por tema. -->
    <Styles.Resources>
        <ResourceDictionary>
            <!-- Reemplaza Win95Style.DrawBevel: dos anillos concentricos con brillo/sombra segun
                 Sunken. Win95 los deja pegados y asimetricos (TemaBevelGrosorExterior recorta a
                 solo arriba+izquierda) para el bisel clasico de un solo trazo; Zelda/Sonic los
                 separan con Margin y grosor parejo en las 4 caras para el marco doble - misma
                 estructura, solo cambian los valores por tema. -->
            <ControlTheme x:Key="{x:Type controls:Win95Bevel}" TargetType="controls:Win95Bevel">
                <Setter Property="Padding" Value="2" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource TemaBevelRadioExterior}" />
                            <Border Name="PART_AnilloExterior" CornerRadius="{DynamicResource TemaBevelRadioExterior}"
                                    BorderThickness="{DynamicResource TemaBevelGrosorExterior}"
                                    BorderBrush="{DynamicResource TemaBevelLightBrush}"
                                    IsVisible="{TemplateBinding TieneBisel}" />
                            <Border Name="PART_AnilloInterior" CornerRadius="{DynamicResource TemaBevelRadioInterior}"
                                    Margin="{DynamicResource TemaBevelMargenInterior}"
                                    BorderThickness="{DynamicResource TemaBevelGrosorInterior}"
                                    BorderBrush="{DynamicResource TemaBevelDarkBrush}"
                                    IsVisible="{TemplateBinding TieneBisel}" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:sunken /template/ Border#PART_AnilloExterior">
                    <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
                </Style>
                <Style Selector="^:sunken /template/ Border#PART_AnilloInterior">
                    <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelLightBrush}" />
                </Style>
            </ControlTheme>

            <!-- Reemplaza Button.cs: bisel Win95 en vez del hover/press por polling -->
            <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource TemaBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TemaTextoBrush}" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{DynamicResource TemaFontFamily}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <controls:Win95Bevel Name="PART_Bevel" BevelThickness="2" Padding="0" Background="{TemplateBinding Background}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </controls:Win95Bevel>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:pointerover /template/ controls|Win95Bevel#PART_Bevel">
                    <Setter Property="Background" Value="{DynamicResource TemaHoverBrush}" />
                </Style>
                <Style Selector="^:pressed /template/ controls|Win95Bevel#PART_Bevel">
                    <Setter Property="Sunken" Value="True" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.55" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <!--
        Lo de abajo NO son ControlTheme con x:Key (que reemplazan el template entero, como Button):
        son Style sueltos que solo tocan color/bisel de controles nativos (TextBox, ScrollBar, Menu,
        TreeView) sin tocar su Template original, para no arriesgar romper su comportamiento
        (caret, drag del thumb, etc.) reimplementando esas partes a mano.
    -->

    <!-- caja de texto: fondo + borde oscuro solido (bisel hundido real no se puede sin
         reemplazar el Template, que requiere PART_TextPresenter con los bindings exactos) -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource TemaCampoFondoBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TemaCampoTextoBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontFamily" Value="{DynamicResource TemaFontFamily}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource TemaTitleBarBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover, TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
    </Style>

    <!-- scrollbar: track + thumb/flechas con bisel, sobre el Track/Thumb que ya trae el tema
         base (SimpleTheme) - mas chico que reescribir el Template de ScrollBar/Track entero -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource TemaScrollTrackBrush}" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource TemaBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="MinHeight" Value="14" />
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton">
        <Setter Property="Background" Value="{DynamicResource TemaBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- menu: fondo/hover con contraste, y el cajon de un submenu con bisel en vez del
         popup plano por defecto -->
    <Style Selector="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource TemaFontFamily}" />
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TemaTitleBarBrush}" />
    </Style>
    <Style Selector="MenuItem:selected /template/ TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Menu /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TemaBackgroundBrush}" />
    </Style>
    <!-- el cajon del submenu desplegado: mismo bisel que un menu contextual del explorador -->
    <Style Selector="Popup /template/ Border">
        <Setter Property="Background" Value="{DynamicResource TemaBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- arbol de archivos: fondo transparente (el sunken bevel lo pone ExplorerView) -->
    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource TemaFontFamily}" />
    </Style>

    <!-- red de seguridad: el texto siempre usa el color de texto del tema activo. Sin esto, si el
         SO reporta modo oscuro, los tokens de color de SimpleTheme pueden resolver a un gris claro
         pensado para fondos oscuros, y quedar casi invisible sobre un fondo claro (Win95) o el
         mismo color de fondo (un tema oscuro tipo Zelda). -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TemaTextoBrush}" />
    </Style>

    <!-- checkbox (buscar y reemplazar: "Distingue mayúsculas") -->
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource TemaCampoFondoBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

</Styles>
