<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ParadigmasLenguajePropio.Controls">

    <!-- Template de Win95Bevel UNICO para todos los temas: un ControlTheme por tema no se re-aplica a controles ya creados al cambiar de paleta; la forma sale de DynamicResource -->
    <Styles.Resources>
        <ResourceDictionary>
            <ControlTheme x:Key="{x:Type controls:Win95Bevel}" TargetType="controls:Win95Bevel">
                <Setter Property="Padding" Value="2" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource TemaBevelRadioExterior}" />
                            <Border Name="PART_AnilloExterior" CornerRadius="{DynamicResource TemaBevelRadioExterior}"
                                    BorderThickness="{DynamicResource TemaBevelGrosorExterior}"
                                    BorderBrush="{DynamicResource TemaBevelLightBrush}"
                                    IsVisible="{TemplateBinding TieneBisel}" />
                            <Border Name="PART_AnilloInterior" CornerRadius="{DynamicResource TemaBevelRadioInterior}"
                                    Margin="{DynamicResource TemaBevelMargenInterior}"
                                    BorderThickness="{DynamicResource TemaBevelGrosorInterior}"
                                    BorderBrush="{DynamicResource TemaBevelDarkBrush}"
                                    IsVisible="{TemplateBinding TieneBisel}" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:sunken /template/ Border#PART_AnilloExterior">
                    <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
                </Style>
                <Style Selector="^:sunken /template/ Border#PART_AnilloInterior">
                    <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelLightBrush}" />
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource TemaBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TemaTextoBrush}" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{DynamicResource TemaFontFamily}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <controls:Win95Bevel Name="PART_Bevel" BevelThickness="2" Padding="0" Background="{TemplateBinding Background}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </controls:Win95Bevel>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:pointerover /template/ controls|Win95Bevel#PART_Bevel">
                    <Setter Property="Background" Value="{DynamicResource TemaHoverBrush}" />
                </Style>
                <Style Selector="^:pressed /template/ controls|Win95Bevel#PART_Bevel">
                    <Setter Property="Sunken" Value="True" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.55" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Estilos sueltos sin tocar el Template de los controles nativos, para no romper caret, drag del thumb, etc. -->

    <!-- Bisel hundido real requeriria reemplazar el Template de TextBox -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource TemaCampoFondoBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TemaCampoTextoBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontFamily" Value="{DynamicResource TemaFontFamily}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource TemaTitleBarBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover, TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource TemaScrollTrackBrush}" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource TemaBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="MinHeight" Value="14" />
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton">
        <Setter Property="Background" Value="{DynamicResource TemaBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Una sola geometria de flecha por tema, rotada para las 4 direcciones. Dentro del template de RepeatButton va selector descendente, un segundo /template/ no matchea -->
    <Style Selector="ScrollBar[Orientation=Vertical] /template/ RepeatButton#PART_LineUpButton Path">
        <Setter Property="Data" Value="{DynamicResource TemaFlechaScrollData}" />
        <Setter Property="Fill" Value="{DynamicResource TemaFlechaScrollBrush}" />
    </Style>
    <Style Selector="ScrollBar[Orientation=Vertical] /template/ RepeatButton#PART_LineDownButton Path">
        <Setter Property="Data" Value="{DynamicResource TemaFlechaScrollData}" />
        <Setter Property="Fill" Value="{DynamicResource TemaFlechaScrollBrush}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform">
            <RotateTransform Angle="180" />
        </Setter>
    </Style>
    <Style Selector="ScrollBar[Orientation=Horizontal] /template/ RepeatButton#PART_LineUpButton Path">
        <Setter Property="Data" Value="{DynamicResource TemaFlechaScrollData}" />
        <Setter Property="Fill" Value="{DynamicResource TemaFlechaScrollBrush}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform">
            <RotateTransform Angle="-90" />
        </Setter>
    </Style>
    <Style Selector="ScrollBar[Orientation=Horizontal] /template/ RepeatButton#PART_LineDownButton Path">
        <Setter Property="Data" Value="{DynamicResource TemaFlechaScrollData}" />
        <Setter Property="Fill" Value="{DynamicResource TemaFlechaScrollBrush}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform">
            <RotateTransform Angle="90" />
        </Setter>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource TemaFontFamily}" />
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TemaTitleBarBrush}" />
    </Style>
    <Style Selector="MenuItem:selected /template/ TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Menu /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TemaBackgroundBrush}" />
    </Style>
    <Style Selector="Popup /template/ Border">
        <Setter Property="Background" Value="{DynamicResource TemaBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource TemaFontFamily}" />
    </Style>

    <!-- Sin esto, con el SO en modo oscuro SimpleTheme puede dejar el texto casi invisible -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TemaTextoBrush}" />
    </Style>

    <!-- El texto del tooltip usa TemaCampoTextoBrush: TemaTextoBrush es blanco en Sonic/Mega Man y no se ve sobre el fondo claro -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource TemaTooltipBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource TemaFontFamily}" />
    </Style>
    <Style Selector="ToolTip TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TemaCampoTextoBrush}" />
    </Style>

    <!-- Lista del autocompletado: colores de campo para que el texto contraste en todos los temas -->
    <Style Selector="ListBox.sugerencias">
        <Setter Property="Background" Value="{DynamicResource TemaCampoFondoBrush}" />
    </Style>
    <Style Selector="ListBox.sugerencias TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TemaCampoTextoBrush}" />
    </Style>
    <Style Selector="ListBox.sugerencias ListBoxItem:selected /template/ ContentPresenter, ListBox.sugerencias ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TemaTooltipBackgroundBrush}" />
    </Style>

    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource TemaCampoFondoBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

</Styles>
