<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta "Mega Man" (NES): armadura azul cobalto con highlight cian, textura de bloques tipo
         mamposteria de un castillo de Wily (dos tonos de azul, sin lineas de junta), franja superior
         en degrade vertical cian->azul tipo "carga del Mega Buster", contorno grueso y negro-azulado
         imitando el borde solido de los sprites de la epoca. -->

    <Styles.Resources>
        <ResourceDictionary>
            <!-- textura de fondo: bloques de mamposteria en "running bond" (filas alternadas
                 desfasadas media unidad), dos tonos de azul bien cercanos igual que el piso a
                 cuadros de SonicPaleta.axaml - un tinte, no un grafico que compita con el contenido -->
            <DrawingBrush x:Key="TemaBackgroundBrush" TileMode="Tile" Stretch="None"
                          SourceRect="0,0,16,8" DestinationRect="0,0,16,8">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#16224E">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,16,8" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#1C2F66">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,8,4" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#1C2F66">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="8,4,8,4" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <SolidColorBrush x:Key="TemaScrollTrackBrush" Color="#0B1533" />
            <SolidColorBrush x:Key="TemaTitleBarBrush" Color="#2255CC" />
            <!-- degrade vertical (ni horizontal como Win95/Zelda ni diagonal como Sonic): efecto
                 "carga" del Mega Buster, de cian arriba a azul profundo abajo -->
            <LinearGradientBrush x:Key="TemaTitleBarActivaBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#55CCFF" />
                <GradientStop Offset="1" Color="#1E3F8F" />
            </LinearGradientBrush>
            <!-- ventana sin foco: mismo degrade vertical pero desaturado -->
            <LinearGradientBrush x:Key="TemaTitleBarInactivaBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#8C97B8" />
                <GradientStop Offset="1" Color="#5A5A72" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="TemaBevelLightBrush" Color="#55CCFF" />
            <SolidColorBrush x:Key="TemaBevelDarkBrush" Color="#0A1030" />
            <SolidColorBrush x:Key="TemaTooltipBackgroundBrush" Color="#FFF59D" />
            <SolidColorBrush x:Key="TemaDisabledTextBrush" Color="#6E7BA8" />
            <SolidColorBrush x:Key="TemaHoverBrush" Color="#3A6FE0" />
            <SolidColorBrush x:Key="TemaTextoBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TemaCampoFondoBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TemaCampoTextoBrush" Color="#16224E" />
            <FontFamily x:Key="TemaFontFamily">avares://ParadigmasLenguajePropio/Assets/Fonts/Silkscreen-Regular.ttf#Silkscreen</FontFamily>

            <!-- forma del bisel (ver ControlTheme compartido en TemaBase.axaml): esquinas rectas y
                 anillos pegados (sin Margen) como Win95, pero invertido y parejo en las 4 caras -
                 anillo exterior FINO claro y anillo interior GRUESO oscuro, imitando el contorno
                 negro solido y grueso de los sprites de la epoca en vez del bisel 3D de los demas -->
            <CornerRadius x:Key="TemaBevelRadioExterior">0</CornerRadius>
            <CornerRadius x:Key="TemaBevelRadioInterior">0</CornerRadius>
            <Thickness x:Key="TemaBevelGrosorExterior">1</Thickness>
            <Thickness x:Key="TemaBevelGrosorInterior">3</Thickness>
            <Thickness x:Key="TemaBevelMargenInterior">0</Thickness>
        </ResourceDictionary>
    </Styles.Resources>

</Styles>
