<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ParadigmasLenguajePropio.Controls"
             xmlns:services="using:ParadigmasLenguajePropio.Services"
             x:Class="ParadigmasLenguajePropio.Views.DialogOverlayView"
             x:DataType="services:DialogService"
             IsVisible="{Binding IsVisible}"
             Focusable="True"
             KeyDown="Overlay_KeyDown">

    <!-- Reemplaza DialogoModal.cs: fondo oscurecido + ventana con bisel y remaches, ahora como Task async
         en vez de Action<int> alElegir. Sirve tanto para el modal de N botones como para el prompt de texto
         (PedirTexto original), alternando con EsPrompt en vez de ser dos vistas separadas. -->
    <Grid Background="#5A000000">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:Win95Bevel BevelThickness="4" Padding="4" Background="{DynamicResource Win95BackgroundBrush}">
                <StackPanel MinWidth="260" MaxWidth="480">
                    <Border Background="{DynamicResource Win95TitleBarBrush}" Padding="6,4">
                        <TextBlock Text="{Binding Titulo}" Foreground="White" FontSize="16" />
                    </Border>

                    <TextBlock Text="{Binding Mensaje}" Foreground="Black" FontSize="16"
                               TextWrapping="Wrap" Margin="16,16,16,0" />

                    <TextBox Name="PART_CampoPrompt" Text="{Binding ValorTexto, Mode=TwoWay}"
                              IsVisible="{Binding EsPrompt}" Margin="16,10,16,0" FontSize="15" />

                    <ItemsControl ItemsSource="{Binding Botones}" HorizontalAlignment="Center" Margin="0,16"
                                  x:CompileBindings="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Width="70" Height="24" FontSize="15"
                                        Command="{Binding $parent[UserControl].DataContext.ElegirBotonCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:Win95Bevel>

            <!-- remaches en las 4 esquinas, como el marco de ventana original -->
            <Border Width="6" Height="6" Background="{DynamicResource Win95BevelDarkBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3">
                <Border Width="4" Height="4" Background="{DynamicResource Win95BevelLightBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Border>
            <Border Width="6" Height="6" Background="{DynamicResource Win95BevelDarkBrush}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3">
                <Border Width="4" Height="4" Background="{DynamicResource Win95BevelLightBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Border>
            <Border Width="6" Height="6" Background="{DynamicResource Win95BevelDarkBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3">
                <Border Width="4" Height="4" Background="{DynamicResource Win95BevelLightBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Border>
            <Border Width="6" Height="6" Background="{DynamicResource Win95BevelDarkBrush}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3">
                <Border Width="4" Height="4" Background="{DynamicResource Win95BevelLightBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Border>
        </Grid>
    </Grid>

</UserControl>
