<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ParadigmasLenguajePropio.Controls"
             xmlns:vm="using:ParadigmasLenguajePropio.ViewModels"
             xmlns:conv="using:ParadigmasLenguajePropio.Converters"
             xmlns:models="using:ParadigmasLenguajePropio.Models"
             xmlns:views="using:ParadigmasLenguajePropio.Views"
             x:Class="ParadigmasLenguajePropio.Views.TerminalView"
             x:DataType="vm:TerminalViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.pestanaActiva">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.tituloPestana">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="4,0,0,0">
        <DockPanel Grid.Row="0" Margin="0,4,4,4" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="2">
                <controls:Win95Bevel Width="90" Height="22" BevelThickness="2" Sunken="{Binding EsTabProblemas}"
                                      Background="{DynamicResource TemaBackgroundBrush}" PointerPressed="TabProblemas_PointerPressed">
                    <TextBlock Text="Problemas" Classes="tituloPestana" />
                </controls:Win95Bevel>

                <controls:Win95Bevel Width="80" Height="22" BevelThickness="2" Sunken="{Binding EsTabTerminal}"
                                      Background="{DynamicResource TemaBackgroundBrush}" PointerPressed="TabTerminal_PointerPressed">
                    <TextBlock Text="Terminal" Classes="tituloPestana" />
                </controls:Win95Bevel>

                <controls:Win95Bevel Width="70" Height="22" BevelThickness="2" Sunken="{Binding EsTabErrores}"
                                      Background="{DynamicResource TemaBackgroundBrush}" PointerPressed="TabErrores_PointerPressed">
                    <TextBlock Text="Errores" Classes="tituloPestana" />
                </controls:Win95Bevel>
            </StackPanel>

            <Button DockPanel.Dock="Right" Width="22" Height="22" Padding="0" FontSize="14" FontWeight="Bold" Content="+"
                    Command="{Binding CrearTerminalCommand}" IsVisible="{Binding MuestraBotonCrear}"
                    ToolTip.Tip="Nueva terminal" />
        </DockPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <ItemsControl Grid.Column="1" ItemsSource="{Binding InstanciasOcultas}" IsVisible="{Binding EsTabTerminal}"
                          VerticalAlignment="Top" Margin="4,0,0,0" x:CompileBindings="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TerminalInstanceViewModel">
                        <controls:Win95Bevel Height="22" BevelThickness="2" Opacity="0.6"
                                              Background="{DynamicResource TemaBackgroundBrush}"
                                              PointerPressed="InstanciaOculta_PointerPressed"
                                              PointerMoved="InstanciaOculta_PointerMoved"
                                              PointerReleased="InstanciaOculta_PointerReleased"
                                              ToolTip.Tip="Arrastrar o clickear para mostrar">
                            <TextBlock Text="{Binding Nombre}" FontSize="13" Margin="6,0" VerticalAlignment="Center" />
                        </controls:Win95Bevel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ItemsSource con TODAS las instancias: sacar una destruiria su vista (y la sesion PTY); las ocultas se esconden via IsVisible del contenedor -->
            <ItemsControl Grid.Column="0" Name="PART_Columnas" ItemsSource="{Binding Instancias}" IsVisible="{Binding EsTabTerminal}" x:CompileBindings="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TerminalInstanceViewModel">
                        <Grid RowDefinitions="Auto,*" Margin="2,0">
                            <controls:Win95Bevel Grid.Row="0" Height="22" BevelThickness="2" Margin="0,0,0,2"
                                                  Background="{DynamicResource TemaBackgroundBrush}"
                                                  PointerPressed="Pestana_PointerPressed" PointerMoved="Pestana_PointerMoved" PointerReleased="Pestana_PointerReleased">
                                <StackPanel Orientation="Horizontal" Margin="6,0" Spacing="6">
                                    <TextBlock Text="{Binding Nombre}" FontSize="14" VerticalAlignment="Center" Classes.pestanaActiva="{Binding EsActiva}" />
                                    <Border Width="12" Height="12" Background="Transparent"
                                            PointerPressed="OcultarInstancia_PointerPressed" ToolTip.Tip="Ocultar (sigue corriendo)">
                                        <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{DynamicResource TemaTextoBrush}" StrokeThickness="1" />
                                    </Border>
                                    <Border Width="12" Height="12" Background="Transparent"
                                            PointerPressed="EliminarInstancia_PointerPressed" ToolTip.Tip="Eliminar terminal">
                                        <Canvas Width="10" Height="10">
                                            <Rectangle Canvas.Left="1" Canvas.Top="1.5" Width="8" Height="1.3" Fill="{DynamicResource TemaTextoBrush}" />
                                            <Path Data="M2,3 L2.6,9.5 L7.4,9.5 L8,3 Z" Stroke="{DynamicResource TemaTextoBrush}" StrokeThickness="1" />
                                            <Path Data="M3.2,1.5 L3.2,0.2 L6.8,0.2 L6.8,1.5" Stroke="{DynamicResource TemaTextoBrush}" StrokeThickness="1" />
                                        </Canvas>
                                    </Border>
                                </StackPanel>
                            </controls:Win95Bevel>

                            <!-- Las dos viven en el arbol; ClaudeTerminalView revisa EsReal antes de abrir un shell real -->
                            <Grid Grid.Row="1">
                                <views:TerminalInstanceView DataContext="{Binding}" IsVisible="{Binding !EsReal}" />
                                <views:ClaudeTerminalView DataContext="{Binding}" IsVisible="{Binding EsReal}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Name="PART_LineaInsercion" Width="3" HorizontalAlignment="Left" Background="#FF3070C0"
                    IsVisible="False" IsHitTestVisible="False" />

            <controls:Win95Bevel Sunken="True" BevelThickness="4" Background="Black" Padding="10" IsVisible="{Binding EsTabErrores}">
                <ScrollViewer Name="PART_ScrollErrores">
                    <ItemsControl ItemsSource="{Binding LineasErrores}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TerminalLinea">
                                <TextBlock FontFamily="{DynamicResource TemaFontFamily}" FontSize="16" TextWrapping="Wrap"
                                           Text="{Binding Texto}"
                                           Foreground="{Binding Color, Converter={x:Static conv:TerminalColorConverter.Instance}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </controls:Win95Bevel>

            <controls:Win95Bevel Sunken="True" BevelThickness="4" Background="Black" Padding="4" IsVisible="{Binding EsTabProblemas}">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="No hay problemas" FontFamily="{DynamicResource TemaFontFamily}" FontSize="16"
                                   Foreground="White" Margin="6" IsVisible="{Binding !HayProblemas}" />

                        <ItemsControl ItemsSource="{Binding Problemas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ProblemaItem">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,4" Background="Transparent"
                                            Command="{Binding $parent[UserControl].((vm:TerminalViewModel)DataContext).AbrirProblemaEnEditorCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Ubicacion}" FontFamily="{DynamicResource TemaFontFamily}" FontSize="15"
                                                           Foreground="{Binding Severidad, Converter={x:Static conv:TerminalColorConverter.Instance}}" />
                                                <TextBlock Text="{Binding Mensaje}" FontFamily="{DynamicResource TemaFontFamily}" FontSize="15"
                                                           TextWrapping="Wrap" Foreground="White" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Causa, StringFormat='Posible causa: {0}'}" IsVisible="{Binding TieneCausa}"
                                                       FontFamily="{DynamicResource TemaFontFamily}" FontSize="14" TextWrapping="Wrap"
                                                       Foreground="#A0A0A0" Margin="16,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </controls:Win95Bevel>
        </Grid>
    </Grid>

</UserControl>
