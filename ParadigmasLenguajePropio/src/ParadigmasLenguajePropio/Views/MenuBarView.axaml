<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ParadigmasLenguajePropio.ViewModels"
             xmlns:controls="using:ParadigmasLenguajePropio.Controls"
             x:Class="ParadigmasLenguajePropio.Views.MenuBarView"
             x:DataType="vm:MenuBarViewModel">

    <StackPanel Orientation="Horizontal" Height="26" x:CompileBindings="False">
        <ItemsControl ItemsSource="{Binding Menus}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Name="PART_Encabezado" Background="Transparent"
                            PointerPressed="Encabezado_PointerPressed" PointerEntered="Encabezado_PointerEntered">
                        <Border.Styles>
                            <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#3CFFFFFF" />
                            </Style>
                        </Border.Styles>

                        <Panel>
                            <controls:Win95Bevel IsVisible="{Binding EsAbierto}" IsHitTestVisible="False"
                                                  Sunken="True" BevelThickness="1" Background="#3CFFFFFF" />
                            <TextBlock Text="{Binding Titulo}" Foreground="White" FontSize="16" VerticalAlignment="Center"
                                       Margin="8,0" IsHitTestVisible="False" />

                            <!-- ShouldUseOverlayLayer: sin esto en Linux el popup es una ventana aparte que no sigue a la principal -->
                            <Popup PlacementTarget="{Binding #PART_Encabezado}" Placement="BottomEdgeAlignedLeft"
                                   IsOpen="{Binding EsAbierto}" IsLightDismissEnabled="False" WindowManagerAddShadowHint="False"
                                   ShouldUseOverlayLayer="True">
                                <controls:Win95Bevel BevelThickness="2" Padding="2" Background="{DynamicResource TemaBackgroundBrush}">
                                    <ItemsControl ItemsSource="{Binding Items}" MinWidth="170">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Panel>
                                                    <controls:Win95Divider IsVisible="{Binding EsSeparador}" Margin="4,3" />
                                                    <Border IsVisible="{Binding !EsSeparador}" Background="Transparent"
                                                            PointerPressed="Item_PointerPressed"
                                                            PointerEntered="Item_PointerEntered" PointerExited="Item_PointerExited">
                                                        <controls:Win95Bevel Sunken="True" BevelThickness="1" Padding="17,3"
                                                                             TieneBisel="{Binding EsResaltado}">
                                                            <TextBlock Text="{Binding Texto}" FontSize="14" Foreground="{DynamicResource TemaTextoBrush}" />
                                                        </controls:Win95Bevel>
                                                    </Border>
                                                </Panel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </controls:Win95Bevel>
                            </Popup>
                        </Panel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>

</UserControl>
