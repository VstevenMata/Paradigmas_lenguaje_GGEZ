<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ParadigmasLenguajePropio.Controls"
             xmlns:vm="using:ParadigmasLenguajePropio.ViewModels"
             xmlns:models="using:ParadigmasLenguajePropio.Models"
             xmlns:conv="using:ParadigmasLenguajePropio.Converters"
             x:Class="ParadigmasLenguajePropio.Views.ChatView"
             x:DataType="vm:ChatViewModel">

    <!-- Panel de chat de la extension Claude: vive debajo de PanelJuegoView (ver MainWindow.axaml),
         una sola instancia a la vez. El hilo de mensajes es lineal (rol + texto en bloque), como el
         panel de chat de VS Code, no burbujas tipo SMS. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Height="26" Background="{DynamicResource Win95TitleBarBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Claude" Foreground="White" FontSize="16"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Width="20" Height="20" Margin="0,0,4,0" Padding="2" Background="Transparent"
                        Command="{Binding CerrarCommand}" ToolTip.Tip="Cerrar">
                    <Path Data="M3,3 L13,13 M13,3 L3,13" Stroke="White" StrokeThickness="1" />
                </Button>
            </Grid>
        </Border>

        <controls:Win95Bevel Grid.Row="1" Sunken="True" BevelThickness="3" Background="White" Padding="6" Margin="0,4,0,0">
            <ScrollViewer Name="PART_Scroll">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Mensajes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatMensaje">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding DeUsuario, Converter={x:Static conv:BoolToTextoConverter.Instance}, ConverterParameter=Tú|Claude}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{Binding DeUsuario, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter=#1E1E1E|#D97757}" />
                                    <TextBlock Text="{Binding Texto}" FontSize="13" Foreground="Black"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Claude esta escribiendo..." FontSize="12" Foreground="Gray" IsVisible="{Binding Enviando}" />
                </StackPanel>
            </ScrollViewer>
        </controls:Win95Bevel>

        <controls:Win95Bevel Grid.Row="2" Sunken="True" BevelThickness="2" Background="White" Padding="4" Margin="0,4,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Name="PART_Entrada" Text="{Binding EntradaActual, Mode=TwoWay}"
                         PlaceholderText="Escribe un mensaje..." AcceptsReturn="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" FontSize="13" MaxHeight="90"
                         VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Enviar" Width="64" Margin="4,0,0,0"
                        Command="{Binding EnviarCommand}" />
            </Grid>
        </controls:Win95Bevel>
    </Grid>

</UserControl>
