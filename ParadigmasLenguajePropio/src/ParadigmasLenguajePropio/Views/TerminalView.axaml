<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ParadigmasLenguajePropio.Controls"
             xmlns:vm="using:ParadigmasLenguajePropio.ViewModels"
             xmlns:conv="using:ParadigmasLenguajePropio.Converters"
             xmlns:models="using:ParadigmasLenguajePropio.Models"
             xmlns:views="using:ParadigmasLenguajePropio.Views"
             x:Class="ParadigmasLenguajePropio.Views.TerminalView"
             x:DataType="vm:TerminalViewModel">

    <!-- Reemplaza PanelTerminal.cs: el ScrollViewer+TextWrapping nativos reemplazan el
         corte-de-lineas/scroll a mano (CalcularCortes/ScrollBarWin95), y un TextBox real da
         caret/seleccion/portapapeles gratis para la linea viva - solo los atajos propios de la
         terminal (historial, autocompletar, Ctrl+C, etc.) se interceptan a mano en el code-behind. -->
    <Grid RowDefinitions="Auto,*" Margin="4,0,0,0">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,4">
            <controls:Win95Bevel Width="70" Height="22" BevelThickness="2" Sunken="{Binding !EsTabTerminal}"
                                  Background="{DynamicResource Win95BackgroundBrush}" PointerPressed="TabTerminal_PointerPressed">
                <TextBlock Text="Terminal" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </controls:Win95Bevel>
            <controls:Win95Bevel Width="70" Height="22" BevelThickness="2" Sunken="{Binding !EsTabErrores}"
                                  Background="{DynamicResource Win95BackgroundBrush}" Margin="4,0,0,0" PointerPressed="TabErrores_PointerPressed">
                <TextBlock Text="Errores" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </controls:Win95Bevel>
        </StackPanel>

        <!-- con la extension instalada, la pestaña "Terminal" pasa a ser una terminal real (PTY) en
             vez de la simulada por pipes de mas abajo - "Errores" (salida de Construir) no cambia
             nunca, asi que solo se tapa cuando ademas estamos parados en la pestaña Terminal (ver
             MostrarTerminalReal). Hereda el DataContext (TerminalViewModel) sin pisarlo, a diferencia
             de ExplorerView/ExtensionsView en MainWindow.axaml, porque ClaudeTerminalView solo
             necesita leer DirectorioActual, no todo un sub-ViewModel propio -->
        <Border Grid.Row="1" IsVisible="{Binding MostrarTerminalReal}">
            <views:ClaudeTerminalView />
        </Border>

        <controls:Win95Bevel Grid.Row="1" Sunken="True" BevelThickness="4" Background="Black" Padding="10"
                              IsVisible="{Binding MostrarTerminalSimulada}" PointerPressed="Fondo_PointerPressed">
            <ScrollViewer Name="PART_Scroll">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding LineasTerminal}" IsVisible="{Binding EsTabTerminal}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TerminalLinea">
                                <TextBlock FontFamily="{DynamicResource Win95FontFamily}" FontSize="16" TextWrapping="Wrap">
                                    <Run Text="{Binding Prefijo}" Foreground="#00E430" /><Run
                                        Text="{Binding Texto}"
                                        Foreground="{Binding Color, Converter={x:Static conv:TerminalColorConverter.Instance}}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- linea viva: solo en la pestana Terminal -->
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding EsTabTerminal}">
                        <TextBlock Text="{Binding PrefijoEntrada}" FontFamily="{DynamicResource Win95FontFamily}"
                                   FontSize="16" Foreground="#00E430" VerticalAlignment="Center" />
                        <TextBox Name="PART_Entrada" Text="{Binding EntradaActual, Mode=TwoWay}"
                                 FontFamily="{DynamicResource Win95FontFamily}" FontSize="16"
                                 Foreground="White" CaretBrush="White" Background="Transparent"
                                 BorderThickness="0" Padding="0" MinWidth="4" VerticalAlignment="Center"
                                 GotFocus="Entrada_GotFocus" LostFocus="Entrada_LostFocus" KeyDown="Entrada_KeyDown" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding LineasErrores}" IsVisible="{Binding EsTabErrores}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TerminalLinea">
                                <TextBlock FontFamily="{DynamicResource Win95FontFamily}" FontSize="16" TextWrapping="Wrap"
                                           Text="{Binding Texto}"
                                           Foreground="{Binding Color, Converter={x:Static conv:TerminalColorConverter.Instance}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </controls:Win95Bevel>
    </Grid>

</UserControl>
