<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ParadigmasLenguajePropio.Controls"
             xmlns:vm="using:ParadigmasLenguajePropio.ViewModels"
             xmlns:conv="using:ParadigmasLenguajePropio.Converters"
             x:Class="ParadigmasLenguajePropio.Views.EditorView"
             x:DataType="vm:EditorViewModel"
             Focusable="True" KeyDown="Editor_KeyDown">

    <Grid Name="PART_GridRaiz" RowDefinitions="Auto,Auto,*">

        <ScrollViewer Name="PART_ScrollTabs" Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      IsVisible="{Binding HayArchivosAbiertos}">
            <ItemsControl ItemsSource="{Binding Tabs}" x:CompileBindings="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,4,0,0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:Win95Bevel Margin="0,0,3,0" Padding="8,4" MaxWidth="130" BevelThickness="2"
                                              Background="{DynamicResource TemaBackgroundBrush}"
                                              PointerPressed="Tab_PointerPressed"
                                              PointerMoved="Tab_PointerMoved"
                                              PointerReleased="Tab_PointerReleased">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource TemaTextoBrush}" VerticalAlignment="Center"
                                         IsVisible="{Binding Modificado}" />
                                <Image Source="{Binding Nombre, Converter={x:Static conv:EditorTabIconoConverter.Instance}}"
                                       Width="16" Height="16" RenderOptions.BitmapInterpolationMode="None" />
                                <TextBlock Text="{Binding Nombre}" FontSize="14" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="80" />
                                <Border Width="14" Height="14" Background="Transparent" PointerPressed="Cerrar_PointerPressed">
                                    <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="{DynamicResource TemaTextoBrush}" StrokeThickness="1" />
                                </Border>
                            </StackPanel>
                        </controls:Win95Bevel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" IsVisible="{Binding HayArchivosAbiertos}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="0,2,6,2" Padding="6,1" x:CompileBindings="False"
                        Command="{Binding $parent[Window].DataContext.ConstruirCommand}" CommandParameter="{Binding TabActiva}"
                        ToolTip.Tip="Compilar y ejecutar (F5)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="avares://ParadigmasLenguajePropio/Assets/Icons/Icon_Play.png" Width="14" Height="14"
                               RenderOptions.BitmapInterpolationMode="None" />
                        <TextBlock Text="Ejecutar" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding BreadcrumbSegmentos}" Margin="6,3" x:CompileBindings="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text=" › " FontSize="12" Foreground="Gray" VerticalAlignment="Center"
                                           IsVisible="{Binding MostrarSeparadorAntes}" />
                                <Border Name="PART_Segmento" Background="Transparent" Padding="2,0"
                                        PointerPressed="Segmento_PointerPressed">
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="#20000000" />
                                        </Style>
                                    </Border.Styles>

                                    <Panel>
                                        <TextBlock Text="{Binding Texto}" FontSize="12" Foreground="Gray"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200" />

                                        <Popup PlacementTarget="{Binding #PART_Segmento}" Placement="BottomEdgeAlignedLeft"
                                               IsOpen="{Binding EsAbierto, Mode=TwoWay}" WindowManagerAddShadowHint="False"
                                               ShouldUseOverlayLayer="True">
                                            <controls:Win95Bevel BevelThickness="2" Padding="2" Background="{DynamicResource TemaBackgroundBrush}">
                                                <ScrollViewer MaxHeight="260">
                                                    <ItemsControl ItemsSource="{Binding Items}" MinWidth="160">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="Transparent"
                                                                        PointerPressed="ItemBreadcrumb_PointerPressed"
                                                                        PointerEntered="ItemBreadcrumb_PointerEntered"
                                                                        PointerExited="ItemBreadcrumb_PointerExited">
                                                                    <controls:Win95Bevel Sunken="True" BevelThickness="1" Padding="10,4"
                                                                                         TieneBisel="{Binding EsResaltado}">
                                                                        <TextBlock Text="{Binding NombreMostrado}" FontSize="13" Foreground="{DynamicResource TemaTextoBrush}" />
                                                                    </controls:Win95Bevel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </controls:Win95Bevel>
                                        </Popup>
                                    </Panel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
            <controls:Win95Divider Orientation="Horizontal" />
        </StackPanel>

        <!-- Fondo por estilo y no atributo: un valor local le ganaria a la clase "oscuro" -->
        <controls:Win95Bevel Grid.Row="2" Sunken="True" BevelThickness="3" Padding="0"
                             Classes.oscuro="{Binding Extensiones.ModoOscuro.Instalada}">
            <controls:Win95Bevel.Styles>
                <Style Selector="controls|Win95Bevel">
                    <Setter Property="Background" Value="White" />
                </Style>
                <Style Selector="controls|Win95Bevel.oscuro">
                    <Setter Property="Background" Value="#0F1117" />
                </Style>
            </controls:Win95Bevel.Styles>
            <Grid Name="PART_GridContenido">
                <StackPanel IsVisible="{Binding !HayArchivosAbiertos}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Image Source="avares://ParadigmasLenguajePropio/Assets/Icons/Icon_Fantasma128px.png"
                           Width="128" Height="128" RenderOptions.BitmapInterpolationMode="None" />
                    <TextBlock Text="Sin archivos abiertos" FontSize="18" Foreground="Gray" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Minimapa y scrollbar propios de cada panel; la scrollbar nativa va Hidden (el scroll sigue andando) y se sincroniza en SincronizarMinimapa -->
                <Grid IsVisible="{Binding HayArchivosAbiertos}" ColumnDefinitions="*,Auto,Auto">
                    <ScrollViewer Name="PART_ScrollVertical" Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                        <Grid ColumnDefinitions="Auto,*">
                            <controls:EditorGutter Name="PART_Gutter" Grid.Column="0" Tab="{Binding TabActiva}" TamanoFuente="{Binding TamanoFuente}"
                                                   ModoOscuro="{Binding Extensiones.ModoOscuro.Instalada}" />
                            <ScrollViewer Name="PART_ScrollHorizontal" Grid.Column="1"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <!-- MinWidth = viewport: si no, con lineas cortas el control queda angosto y el click en la fila no llega -->
                                <controls:EditorTextArea Name="PART_TextArea" Tab="{Binding TabActiva}" Extensiones="{Binding Extensiones}"
                                                          TamanoFuente="{Binding TamanoFuente}" TamanoTab="{Binding TamanoTab}"
                                                          MinWidth="{Binding #PART_ScrollHorizontal.Bounds.Width}" />
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>

                    <controls:EditorMinimap Grid.Column="1" Name="PART_Minimap" Width="60" Tab="{Binding TabActiva}" />

                    <ScrollBar Name="PART_ScrollBarVertical" Grid.Column="2" Orientation="Vertical" />
                </Grid>

                <!-- Fuera del Grid de arriba porque se pueden abrir sin archivos abiertos -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,4,0,0" Spacing="8">

                    <!-- Top para que el StackPanel no lo estire a la altura de "Buscar" -->
                    <Border VerticalAlignment="Top" BoxShadow="1 2 6 0 #60000000" IsVisible="{Binding IrALineaVisible}">
                        <controls:Win95Bevel BevelThickness="2" Background="{DynamicResource TemaBackgroundBrush}">
                            <StackPanel Margin="6" Spacing="2">
                                <TextBlock Text="Ir a línea" FontSize="11" Foreground="Gray" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBox Name="PART_CampoIrALinea" Width="80" Height="22" FontSize="13" Text="{Binding NumeroLineaTexto, Mode=TwoWay}"
                                             Background="White" BorderThickness="1" BorderBrush="{DynamicResource TemaBevelDarkBrush}"
                                             Padding="4,0" VerticalContentAlignment="Center" KeyDown="CampoIrALinea_KeyDown" />
                                    <Button Content="✕" Width="24" Click="CerrarIrALinea_Click" />
                                </StackPanel>
                            </StackPanel>
                        </controls:Win95Bevel>
                    </Border>

                    <!-- Border externo solo para la sombra (Win95Bevel no la expone) -->
                    <Border VerticalAlignment="Top" BoxShadow="1 2 6 0 #60000000" IsVisible="{Binding BuscarVisible}">
                        <controls:Win95Bevel BevelThickness="2" Background="{DynamicResource TemaBackgroundBrush}">
                            <StackPanel Margin="6" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Width="160" Height="22" Background="White" BorderThickness="1"
                                            BorderBrush="{DynamicResource TemaBevelDarkBrush}">
                                        <DockPanel LastChildFill="True" Margin="4,0">
                                            <Image DockPanel.Dock="Left" Width="11" Height="11" Margin="0,0,4,0"
                                                   Source="avares://ParadigmasLenguajePropio/Assets/Icons/Icon_Lupa.png"
                                                   RenderOptions.BitmapInterpolationMode="None" />
                                            <TextBox Name="PART_CampoBuscar" FontSize="13" Text="{Binding PatronBusqueda, Mode=TwoWay}"
                                                     Background="Transparent" BorderThickness="0" Padding="0"
                                                     VerticalContentAlignment="Center" KeyDown="CampoBuscar_KeyDown" />
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Text="{Binding ContadorBusqueda}" FontSize="13" VerticalAlignment="Center" MinWidth="40" />
                                    <Button Content="↑" Width="24" Click="BuscarAnterior_Click" />
                                    <Button Content="↓" Width="24" Click="BuscarSiguiente_Click" />
                                    <Button Content="✕" Width="24" Click="CerrarBusqueda_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding MostrarReemplazo}">
                                    <TextBox Width="160" Height="22" FontSize="13" Text="{Binding TextoReemplazo, Mode=TwoWay}"
                                             Background="White" BorderThickness="1" BorderBrush="{DynamicResource TemaBevelDarkBrush}"
                                             Padding="4,0" VerticalContentAlignment="Center" />
                                    <Button Content="Reemplazar" FontSize="12" Click="Reemplazar_Click" />
                                    <Button Content="Todo" FontSize="12" Click="ReemplazarTodo_Click" />
                                </StackPanel>
                                <CheckBox Content="Distingue mayúsculas" FontSize="12" IsChecked="{Binding DistingueMayusculas, Mode=TwoWay}" />
                            </StackPanel>
                        </controls:Win95Bevel>
                    </Border>
                </StackPanel>

                <Border Name="PART_OverlayDrop" IsVisible="False" IsHitTestVisible="False"
                        Background="#4055AAFF" BorderThickness="2" BorderBrush="#FF3070C0" />
            </Grid>
        </controls:Win95Bevel>
    </Grid>

</UserControl>
