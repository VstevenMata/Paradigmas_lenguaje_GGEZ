<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ParadigmasLenguajePropio.Controls"
             xmlns:vm="using:ParadigmasLenguajePropio.ViewModels"
             xmlns:conv="using:ParadigmasLenguajePropio.Converters"
             x:Class="ParadigmasLenguajePropio.Views.EditorView"
             x:DataType="vm:EditorViewModel"
             Focusable="True" KeyDown="Editor_KeyDown">

    <!-- Reemplaza PanelCentral.cs. El texto/cursor/selección los dibuja EditorTextArea (control
         custom); acá se arma todo lo demás: tabs, el par de ScrollViewer que reemplazan
         ScrollBarWin95 (uno vertical envolviendo gutter+texto, uno horizontal solo para el texto,
         así los números de línea no se desplazan de lado), y las barras de buscar/ir-a-línea. -->
    <Grid Name="PART_GridRaiz" RowDefinitions="Auto,*">

        <!-- tabs -->
        <ScrollViewer Name="PART_ScrollTabs" Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      IsVisible="{Binding HayArchivosAbiertos}">
            <ItemsControl ItemsSource="{Binding Tabs}" x:CompileBindings="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,4,0,0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- PointerMoved/PointerReleased, junto con Tab_PointerPressed, arman el gesto
                             de arrastre (ver code-behind): un click simple sigue activando la pestaña
                             de inmediato, recien al moverse mas de unos pixeles con el boton apretado
                             arranca el drag-and-drop real -->
                        <controls:Win95Bevel Margin="0,0,3,0" Padding="8,4" MaxWidth="130" BevelThickness="2"
                                              Background="{DynamicResource Win95BackgroundBrush}"
                                              PointerPressed="Tab_PointerPressed"
                                              PointerMoved="Tab_PointerMoved"
                                              PointerReleased="Tab_PointerReleased">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="4" Height="4" Fill="Black" VerticalAlignment="Center"
                                         IsVisible="{Binding Modificado}" />
                                <Image Source="{Binding Nombre, Converter={x:Static conv:EditorTabIconoConverter.Instance}}"
                                       Width="16" Height="16" RenderOptions.BitmapInterpolationMode="None" />
                                <TextBlock Text="{Binding Nombre}" FontSize="14" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="80" />
                                <Border Width="14" Height="14" Background="Transparent" PointerPressed="Cerrar_PointerPressed">
                                    <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="Black" StrokeThickness="1" />
                                </Border>
                            </StackPanel>
                        </controls:Win95Bevel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <controls:Win95Bevel Grid.Row="1" Sunken="True" BevelThickness="3" Background="White" Padding="0">
            <Grid Name="PART_GridContenido">
                <!-- sin archivos abiertos: fantasma centrado -->
                <StackPanel IsVisible="{Binding !HayArchivosAbiertos}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Image Source="avares://ParadigmasLenguajePropio/Assets/Icons/Icon_Fantasma128px.png"
                           Width="128" Height="128" RenderOptions.BitmapInterpolationMode="None" />
                    <TextBlock Text="Sin archivos abiertos" FontSize="18" Foreground="Gray" HorizontalAlignment="Center" />
                </StackPanel>

                <Grid IsVisible="{Binding HayArchivosAbiertos}">
                    <ScrollViewer Name="PART_ScrollVertical" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid ColumnDefinitions="Auto,*">
                            <controls:EditorGutter Grid.Column="0" Tab="{Binding TabActiva}" />
                            <ScrollViewer Name="PART_ScrollHorizontal" Grid.Column="1"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <controls:EditorTextArea Name="PART_TextArea" Tab="{Binding TabActiva}" />
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- buscar / reemplazar / ir a linea: van afuera del Grid de arriba (que solo se
                     muestra con HayArchivosAbiertos) porque el boton de la barra lateral los abre
                     igual sin archivos abiertos - con la vieja ubicacion el click no mostraba nada
                     y parecia que el boton estaba roto.
                     Los dos widgets van en un StackPanel horizontal en vez de flotar cada uno con su
                     propio HorizontalAlignment=Right: antes, con los dos abiertos a la vez, quedaban
                     encimados en el mismo punto (ver captura del usuario). Ahora, al estar en el
                     mismo StackPanel alineado a la derecha, "Buscar" siempre queda pegado al borde y
                     "Ir a linea" (que va primero en el orden) se acomoda solo, a su izquierda, sin
                     tapar nada; si alguno esta cerrado el otro no deja hueco (IsVisible=False no
                     ocupa espacio en el StackPanel). -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,4,20,0" Spacing="8">

                    <!-- ir a línea: VerticalAlignment=Top para que no se estire a la altura de "Buscar"
                         (mas alto por el renglon de reemplazar) - sin esto el StackPanel horizontal
                         lo agranda para que coincida, dejando un hueco vacio abajo -->
                    <Border VerticalAlignment="Top" BoxShadow="1 2 6 0 #60000000" IsVisible="{Binding IrALineaVisible}">
                        <controls:Win95Bevel BevelThickness="2" Background="{DynamicResource Win95BackgroundBrush}">
                            <StackPanel Margin="6" Spacing="2">
                                <TextBlock Text="Ir a línea" FontSize="11" Foreground="Gray" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBox Name="PART_CampoIrALinea" Width="80" Height="22" FontSize="13" Text="{Binding NumeroLineaTexto, Mode=TwoWay}"
                                             Background="White" BorderThickness="1" BorderBrush="{DynamicResource Win95BevelDarkBrush}"
                                             Padding="4,0" VerticalContentAlignment="Center" KeyDown="CampoIrALinea_KeyDown" />
                                    <Button Content="✕" Width="24" Click="CerrarIrALinea_Click" />
                                </StackPanel>
                            </StackPanel>
                        </controls:Win95Bevel>
                    </Border>

                    <!-- buscar / reemplazar: Border afuera solo para la sombra (Win95Bevel no la
                         expone), igual que el buscador flotante de VSCode; los campos van con fondo
                         blanco y borde propio (antes se confundian con el fondo del panel). -->
                    <Border VerticalAlignment="Top" BoxShadow="1 2 6 0 #60000000" IsVisible="{Binding BuscarVisible}">
                        <controls:Win95Bevel BevelThickness="2" Background="{DynamicResource Win95BackgroundBrush}">
                            <StackPanel Margin="6" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Width="160" Height="22" Background="White" BorderThickness="1"
                                            BorderBrush="{DynamicResource Win95BevelDarkBrush}">
                                        <DockPanel LastChildFill="True" Margin="4,0">
                                            <Image DockPanel.Dock="Left" Width="11" Height="11" Margin="0,0,4,0"
                                                   Source="avares://ParadigmasLenguajePropio/Assets/Icons/Icon_Lupa.png"
                                                   RenderOptions.BitmapInterpolationMode="None" />
                                            <TextBox Name="PART_CampoBuscar" FontSize="13" Text="{Binding PatronBusqueda, Mode=TwoWay}"
                                                     Background="Transparent" BorderThickness="0" Padding="0"
                                                     VerticalContentAlignment="Center" KeyDown="CampoBuscar_KeyDown" />
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Text="{Binding ContadorBusqueda}" FontSize="13" VerticalAlignment="Center" MinWidth="40" />
                                    <Button Content="↑" Width="24" Click="BuscarAnterior_Click" />
                                    <Button Content="↓" Width="24" Click="BuscarSiguiente_Click" />
                                    <Button Content="✕" Width="24" Click="CerrarBusqueda_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding MostrarReemplazo}">
                                    <TextBox Width="160" Height="22" FontSize="13" Text="{Binding TextoReemplazo, Mode=TwoWay}"
                                             Background="White" BorderThickness="1" BorderBrush="{DynamicResource Win95BevelDarkBrush}"
                                             Padding="4,0" VerticalContentAlignment="Center" />
                                    <Button Content="Reemplazar" FontSize="12" Click="Reemplazar_Click" />
                                    <Button Content="Todo" FontSize="12" Click="ReemplazarTodo_Click" />
                                </StackPanel>
                                <CheckBox Content="Distingue mayúsculas" FontSize="12" IsChecked="{Binding DistingueMayusculas, Mode=TwoWay}" />
                            </StackPanel>
                        </controls:Win95Bevel>
                    </Border>
                </StackPanel>

                <!-- previsualizacion de la zona de destino mientras se arrastra una pestaña (propia
                     o de otro panel): el code-behind mueve/agranda esto en DragOver segun donde este
                     el puntero (mitad de arriba = parte arriba, mitad de abajo = parte abajo, resto =
                     mueve sin partir) - ver EditorView.axaml.cs -->
                <Border Name="PART_OverlayDrop" IsVisible="False" IsHitTestVisible="False"
                        Background="#4055AAFF" BorderThickness="2" BorderBrush="#FF3070C0" />
            </Grid>
        </controls:Win95Bevel>
    </Grid>

</UserControl>
