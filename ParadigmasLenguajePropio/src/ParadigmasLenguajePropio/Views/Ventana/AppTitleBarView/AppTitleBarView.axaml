<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ParadigmasLenguajePropio.ViewModels"
             xmlns:views="using:ParadigmasLenguajePropio.Views"
             xmlns:models="using:ParadigmasLenguajePropio.Models"
             xmlns:controls="using:ParadigmasLenguajePropio.Controls"
             x:Class="ParadigmasLenguajePropio.Views.AppTitleBarView"
             x:DataType="vm:AppTitleBarViewModel"
             Height="26">

    <UserControl.Styles>
        <Style Selector="Button.titlebar-btn">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Chrome" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.titlebar-btn:pointerover /template/ Border#PART_Chrome">
            <Setter Property="Background" Value="LightGray" />
            <Setter Property="BorderBrush" Value="{DynamicResource TemaBevelDarkBrush}" />
        </Style>
        <Style Selector="Button.titlebar-close:pointerover /template/ Border#PART_Chrome">
            <Setter Property="Background" Value="#E81123" />
        </Style>
        <Style Selector="Button.titlebar-close:pointerover Path">
            <Setter Property="Stroke" Value="White" />
        </Style>
    </UserControl.Styles>

    <Border Name="PART_Fondo" Background="{DynamicResource TemaTitleBarActivaBrush}">
        <Panel>
            <Grid ColumnDefinitions="Auto,*,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0" VerticalAlignment="Center">
                    <Image Source="avares://ParadigmasLenguajePropio/Assets/Icons/Icon_logo.png"
                           Width="20" Height="20" RenderOptions.BitmapInterpolationMode="None" />
                    <views:MenuBarView DataContext="{Binding $parent[Window].DataContext.MenuBar}" x:CompileBindings="False" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
                    <Button Classes="titlebar-btn" Name="PART_Minimizar" ToolTip.Tip="Minimizar">
                        <Path Data="M3,13 L13,13" Stroke="{DynamicResource TemaTextoBrush}" StrokeThickness="1" />
                    </Button>
                    <Button Classes="titlebar-btn" Name="PART_Maximizar" ToolTip.Tip="Maximizar">
                        <Path Data="M3.5,3.5 L12.5,3.5 L12.5,12.5 L3.5,12.5 Z" Stroke="{DynamicResource TemaTextoBrush}" StrokeThickness="1" />
                    </Button>
                    <Button Classes="titlebar-btn titlebar-close" Name="PART_Cerrar" ToolTip.Tip="Cerrar">
                        <Path Data="M3,3 L13,13 M13,3 L3,13" Stroke="{DynamicResource TemaTextoBrush}" StrokeThickness="1" />
                    </Button>
                </StackPanel>

            </Grid>

            <!-- Fuera del Grid para centrarse respecto de la ventana y no del espacio libre entre menu y botones -->
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="320" Height="18" Background="{DynamicResource TemaCampoFondoBrush}" BorderThickness="2"
                        BorderBrush="{DynamicResource TemaBevelDarkBrush}">
                    <DockPanel LastChildFill="True" Margin="4,0">
                        <Image DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,4,0"
                               Source="avares://ParadigmasLenguajePropio/Assets/Icons/Icon_Lupa.png"
                               RenderOptions.BitmapInterpolationMode="None" />
                        <TextBox Name="PART_CampoBusqueda" Text="{Binding TextoBusqueda, Mode=TwoWay}"
                                 PlaceholderText="Buscar en el proyecto"
                                 Background="Transparent" BorderThickness="0" Padding="0" FontSize="13"
                                 VerticalContentAlignment="Center" />
                    </DockPanel>
                </Border>

                <Popup PlacementTarget="{Binding #PART_CampoBusqueda}" Placement="Bottom"
                       IsOpen="{Binding ResultadosVisibles}" IsLightDismissEnabled="False" WindowManagerAddShadowHint="False">
                    <Border Width="480" Background="{DynamicResource TemaBackgroundBrush}" BorderThickness="2"
                            BorderBrush="{DynamicResource TemaBevelDarkBrush}">
                        <ItemsControl ItemsSource="{Binding Resultados}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ResultadoBusqueda">
                                    <Border Padding="6,3" Background="Transparent"
                                            PointerPressed="ResultadoFila_PointerPressed">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Nombre}" FontSize="14" />
                                            <TextBlock Text="{Binding RutaMostrada}" FontSize="13" Opacity="0.6" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>

                <Button Classes="titlebar-btn" Width="24" Height="24" ToolTip.Tip="Menú del buscador">
                    <Image Source="avares://ParadigmasLenguajePropio/Assets/Icons/Icon_Menu.png" Width="14" Height="14"
                           RenderOptions.BitmapInterpolationMode="None" />
                </Button>
                <Button Name="PART_BotonTema" Classes="titlebar-btn" Width="24" Height="24" ToolTip.Tip="Cambiar tema"
                        Command="{Binding AlternarMenuTemaCommand}">
                    <Image Source="avares://ParadigmasLenguajePropio/Assets/Icons/Icon_Paint.png" Width="14" Height="14"
                           RenderOptions.BitmapInterpolationMode="None" />
                </Button>

                <Popup PlacementTarget="{Binding #PART_BotonTema}" Placement="BottomEdgeAlignedRight"
                       IsOpen="{Binding MenuTemaAbierto}" IsLightDismissEnabled="True" WindowManagerAddShadowHint="False"
                       ShouldUseOverlayLayer="True">
                    <controls:Win95Bevel BevelThickness="2" Padding="2" Background="{DynamicResource TemaBackgroundBrush}">
                        <ItemsControl ItemsSource="{Binding Temas}" MinWidth="120">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:OpcionTema">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,5" Background="Transparent"
                                            Command="{Binding $parent[UserControl].((vm:AppTitleBarViewModel)DataContext).ElegirTemaCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Nombre}" FontSize="14" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:Win95Bevel>
                </Popup>
            </StackPanel>
        </Panel>
    </Border>

</UserControl>
