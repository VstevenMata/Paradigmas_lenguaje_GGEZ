<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ParadigmasLenguajePropio.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <SimpleTheme />
        <!-- Paleta activa (Win95 por defecto); TemaService la reemplaza en caliente -->
        <StyleInclude Source="avares://ParadigmasLenguajePropio/Themes/Paletas/Win95Paleta.axaml" />
        <StyleInclude Source="avares://ParadigmasLenguajePropio/Themes/TemaBase.axaml" />
    </Application.Styles>

</Application>
